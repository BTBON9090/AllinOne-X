{
  "name": "allinone-plugin",
  "version": "1.0.0",
  "description": "Figma All in One Plugin",
  "main": "dist/code.js",
  "scripts": {
    "build": "npm run build:ui && npm run build:code",
    "build:ui": "vite build",
    "build:code": "esbuild src/code/main.ts --bundle --outfile=dist/code.js --target=es6",
    "watch": "npm run build:ui && npm run watch:code",
    "watch:code": "esbuild src/code/main.ts --bundle --outfile=dist/code.js --target=es6 --watch"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@figma/plugin-typings": "*"
  }
}